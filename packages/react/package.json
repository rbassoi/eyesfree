{
  "name": "@eyesfree/react",
  "version": "0.3.0",
  "description": "React bindings for EyesFree: <EyesFreeProvider>, useEyesFree() and <EyesFreeCalibrator>.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
