    "@eyesfree/web": "0.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": ["react", "hooks", "accessibility", "low-vision"],
  "repository": { "type": "git", "url": "https://github.com/rbassoi/eyesfree.git", "directory": "packages/react" }
