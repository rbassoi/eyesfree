{
  "name": "@eyesfree/web",
  "version": "0.1.0",
  "description": "DOM engine for EyesFree: applies optical compensation (SVG deconvolution filters, ghost cancellation, anti-crowding) to any web app, plus a Web Worker image compensator.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eyesfree.css": "./eyesfree.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "eyesfree.css", "README.md", "LICENSE", "NOTICE"],
  "sideEffects": ["*.css"],
  "dependencies": {
    "@eyesfree/core": "0.1.0"
  },
  "keywords": ["accessibility", "a11y", "low-vision", "svg-filter", "web-worker", "presbyopia"],
  "repository": { "type": "git", "url": "https://github.com/rbassoi/eyesfree.git", "directory": "packages/web" }
}
